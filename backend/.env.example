# Copy to .env and fill in. Every value here is validated at startup by
# app/config.py -- a missing or malformed one fails the boot, not the first
# request. Keep comments on their own lines: dotenv does not reliably strip
# a trailing "# ..." from an unquoted value.

# "development" or "production". Production refuses localhost CORS origins
# and a wildcard ALLOWED_HOSTS.
ENVIRONMENT=development

# https://<project>.supabase.co  (no trailing slash)
SUPABASE_URL=
# sb_secret_... -- NEVER the publishable/anon key, and NEVER set in Vercel.
# This key bypasses RLS; it belongs only to the FastAPI host.
SUPABASE_SERVICE_KEY=
# <SUPABASE_URL>/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_PLAN_MODEL=gemini-3.6-flash
GEMINI_FEEDBACK_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Must match club_documents.embedding vector(768).
EMBEDDING_DIM=768

# JSON lists.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# In production: ["api.yourdomain.com"]
ALLOWED_HOSTS=["*"]
# Optional, for Vercel preview deploys:
# CORS_ORIGIN_REGEX=^https://clubops-ai-[a-z0-9-]+\.vercel\.app$

# "memory://" is per-process. More than one backend instance => redis://...
RATE_LIMIT_STORAGE_URI=memory://

# Optional: default --club-id for the ingestion CLI (python -m app.services.rag).
# DEFAULT_CLUB_ID=
